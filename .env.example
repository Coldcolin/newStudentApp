# Environment Variables Template
# Copy this file to .env.local and fill in your values

# API Base URL - proxied through Next.js rewrites to avoid CORS
NEXT_PUBLIC_API_URL=/api

# Backend URL (server-side only, used by Next.js rewrites)
BACKEND_URL=http://localhost:3001

# Network URL for accessing the app on local network
# Use your machine's local IP address (e.g., http://192.168.1.100:3000)
NEXT_PUBLIC_NETWORK_URL=http://YOUR_LOCAL_IP:3000

# Development server host (for npm run dev -- -H 0.0.0.0)
# This allows other devices on your network to access the app
HOST=0.0.0.0
PORT=3000

# Optional: Database URL (if using a database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: Authentication secrets
# JWT_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-nextauth-secret
